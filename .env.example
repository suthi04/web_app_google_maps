# ===== InsightReview — config =====
# วิธีใช้: คัดลอกไฟล์นี้เป็นชื่อ ".env" (ไม่มี .example) แล้วใส่ค่าของคุณ
# ระบบจะอ่าน .env อัตโนมัติทุกครั้งที่รัน — ไม่ต้อง set ใน terminal อีก
#
#   Windows : copy .env.example .env
#   Mac/Linux: cp .env.example .env
# แล้วเปิดไฟล์ .env แก้ค่าด้านล่าง

# ---------- ดึงรีวิวจริงจาก Google Maps (ออกจากโหมด demo) ----------
# ใส่ Apify token ของคุณ (สมัครฟรีที่ apify.com -> Settings -> API tokens)
APIFY_TOKEN=

# จำนวนรีวิวที่ดึงต่อร้าน (100 กำลังดี เร็วและพอวิเคราะห์)
MAX_REVIEWS=100

# ---------- ใช้ WangchanBERTa วิเคราะห์อารมณ์จริง ----------
# ต้องติดตั้งก่อน: pip install -r requirements-model.txt
# แล้วเปลี่ยนเป็น 1
USE_MODEL=0

# ---------- ใช้ Gemini (LLM) สกัดวลีความเห็น (ทางเลือกเพิ่มเติม) ----------
# ตั้ง GEMINI_API_KEY เพื่อเปิดเครื่องยนต์ Gemini (เลือกได้จากหน้า Settings)
# ขอ key ฟรีที่ Google AI Studio (aistudio.google.com)
# ถ้าไม่ตั้งค่านี้ หรือเรียก API ไม่สำเร็จ ระบบจะ fallback กลับ rule-based อัตโนมัติ
GEMINI_API_KEY=

# โมเดล (ไม่บังคับ) — ค่าเริ่มต้น gemini-2.5-flash-lite (free tier ใช้ได้จริง โควต้า/วันสูงกว่า)
# ใส่ gemini-2.5-flash ได้ถ้ามีโควต้า/จ่ายเงิน (แม่นกว่าเล็กน้อย แต่ฟรีจำกัด ~20 ครั้ง/วัน)
# GEMINI_MODEL=gemini-2.5-flash-lite

# ---------- อื่น ๆ (ไม่ต้องแก้) ----------
# HOST=127.0.0.1
# PORT=5000
# จำนวน HTTP threads ของ Waitress (ใช้กับ python serve.py)
# WEB_THREADS=4
# APIFY_TIMEOUT=300

# ---------- จำเป็นเมื่อ deploy ----------
# ตำแหน่งฐานข้อมูลบน persistent disk ของโฮสต์
# DATABASE_PATH=/var/data/insightreview.db
# สร้างค่าสุ่มยาวและคงที่ ห้ามใช้ค่าตัวอย่างนี้จริง (เช่น python -c "import secrets; print(secrets.token_hex(32))")
# SECRET_KEY=
# เปิดเฉพาะเมื่อเว็บให้บริการผ่าน HTTPS แล้ว เพื่อส่ง session cookie ทาง HTTPS เท่านั้น
# SESSION_COOKIE_SECURE=1
# จำกัดคำขอวิเคราะห์แบบ anonymous ต่อ IP; ตั้ง 0 เพื่อปิด rate limit
# ANALYZE_MAX_REQUESTS=10
# ANALYZE_WINDOW_SECONDS=3600
# จำนวนงานวิเคราะห์ที่รันพร้อมกันต่อโปรเซส (ค่าเริ่มต้น 1 ปลอดภัยกับโมเดล/SQLite)
# ANALYZE_MAX_CONCURRENT=1
# จำนวนงานที่อนุญาตให้รอในคิวต่อโปรเซส
# ANALYZE_MAX_QUEUED=10
# เก็บ metadata ของ job ที่เสร็จ/ล้มเหลวกี่วัน (ผลวิเคราะห์จริงไม่ถูกลบ)
# JOB_RETENTION_DAYS=7
